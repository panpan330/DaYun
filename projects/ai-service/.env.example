# Copy this file to .env for local development.
# Never put real API keys or tokens in .env.example.
# .env is ignored by git; .env.example is safe to commit because it only documents names.
APP_NAME="AI Service"
APP_DESCRIPTION="Python AI service for Java + Python + AI learning project."
APP_VERSION="0.1.0"
MODEL_NAME="mock-chat-model"
LLM_PROVIDER="aliyun-compatible"
LLM_MODEL="qwen3.7-plus"
# Optional multi-model routing.
# Leave tier models blank to fall back to LLM_MODEL.
LLM_FAST_MODEL=""
LLM_BALANCED_MODEL=""
LLM_STRONG_MODEL=""
LLM_DEFAULT_ROUTE_TIER="balanced"
LLM_ROUTE_LONG_INPUT_CHARS=1200
LLM_ROUTE_FAST_KEYWORDS="翻译,改写,摘要,提取,分类"
LLM_ROUTE_STRONG_KEYWORDS="代码审查,架构设计,复杂推理,生产事故,安全分析,SQL优化"
# Optional model fallback. Leave LLM_FALLBACK_MODEL blank to use LLM_FALLBACK_TIER.
LLM_ENABLE_FALLBACK=true
LLM_FALLBACK_MODEL=""
LLM_FALLBACK_TIER="balanced"
LLM_FALLBACK_ERROR_CODES="LLM_TIMEOUT,LLM_RATE_LIMITED,LLM_PROVIDER_ERROR,LLM_CONNECTION_ERROR,LLM_PROVIDER_STATUS_ERROR,LLM_CALL_FAILED,LLM_EMPTY_RESPONSE,LLM_BAD_RESPONSE"
LLM_BASE_URL="https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"
LLM_API_KEY=""
REQUEST_TIMEOUT_SECONDS=30
# Total wall-clock budget for one LLM operation, including retries and fallback.
LLM_TOTAL_TIMEOUT_SECONDS=45
# Application-level retries controlled by ai-service; SDK internal retries are disabled.
LLM_MAX_RETRIES=2
MAX_OUTPUT_TOKENS=1024
# Optional cost control. These are preflight budgets, not exact billing records.
LLM_ENABLE_COST_CONTROL=true
LLM_MAX_INPUT_TOKENS_PER_REQUEST=6000
LLM_MAX_TOTAL_TOKENS_PER_REQUEST=8000
LLM_MIN_OUTPUT_TOKENS=128
# Optional. Uncomment only when token pricing is configured.
# LLM_MAX_ESTIMATED_COST_PER_REQUEST=0.01
LLM_DISABLE_FALLBACK_ABOVE_TOTAL_TOKENS=6000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CLIENT_REQUESTS_PER_WINDOW=120
RATE_LIMIT_ROUTE_REQUESTS_PER_WINDOW=120
RATE_LIMIT_AI_REQUESTS_PER_WINDOW=60
RATE_LIMIT_TOOL_REQUESTS_PER_WINDOW=30
RATE_LIMIT_EXCLUDED_PATHS="/health,/ready"
# Demo-friendly heartbeat interval. 0 disables deterministic chunk-based heartbeat.
SSE_HEARTBEAT_EVERY_CHUNKS=2
# Optional. Fill both prices only if you want estimated LLM cost logs.
# Values are cost per 1,000,000 tokens, not cost per single token.
# LLM_INPUT_COST_PER_MILLION_TOKENS=0.0
# LLM_OUTPUT_COST_PER_MILLION_TOKENS=0.0
LLM_PRICING_CURRENCY="USD"
# rule_based: stable local rules, no model call.
# fake_llm: simulate LLM output through the same JSON/Pydantic path, no model call.
# real_llm: call the configured OpenAI-compatible chat model.
TICKET_AGENT_MODEL_MODE="rule_based"
JAVA_MOCK_SERVICE_BASE_URL="http://127.0.0.1:8001"
JAVA_MOCK_SERVICE_TIMEOUT_SECONDS=5
JAVA_BUSINESS_SERVICE_BASE_URL="http://127.0.0.1:18004"
JAVA_BUSINESS_SERVICE_TIMEOUT_SECONDS=5
JAVA_BUSINESS_INTERNAL_TOKEN="local-dev-internal-token"
JAVA_BUSINESS_INTERNAL_CALLER="ai-service"
JAVA_BUSINESS_DEFAULT_USER_ID="U1001"
JAVA_BUSINESS_DEFAULT_TENANT_ID="default"
QDRANT_BASE_URL="http://localhost:6333"
QDRANT_COLLECTION_NAME="learning_rag_chunks_v4_1024"
QDRANT_TIMEOUT_SECONDS=5
# Keep QDRANT_VECTOR_SIZE equal to EMBEDDING_DIMENSION when using real embedding.
QDRANT_VECTOR_SIZE=1024
QDRANT_API_KEY=""
MILVUS_URI="http://localhost:19530"
MILVUS_COLLECTION_NAME="learning_rag_chunks_milvus"
MILVUS_TIMEOUT_SECONDS=5
# Keep 8 for deterministic fake embedding smoke tests.
# For real embedding ingestion, create/use a collection whose vector size matches EMBEDDING_DIMENSION.
MILVUS_VECTOR_SIZE=8
MILVUS_TOKEN=""
EMBEDDING_PROVIDER="aliyun-compatible"
EMBEDDING_MODEL="text-embedding-v4"
EMBEDDING_BASE_URL="https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"
EMBEDDING_API_KEY=""
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_REQUEST_DIMENSIONS=true
# Generic HTTP rerank adapter used by the real RAG answer chain.
RERANK_PROVIDER="http-compatible"
RERANK_MODEL="qwen3-rerank"
RERANK_BASE_URL="https://your-workspace-id.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank"
RERANK_API_KEY=""
RERANK_TIMEOUT_SECONDS=10
RERANK_MAX_RETRIES=1
RERANK_TOP_N=5
RERANK_CANDIDATE_COUNT=20
TOOL_CONFIRMATION_TTL_SECONDS=300
# Agent thread checkpoints are persisted in Redis. TTL is in minutes.
AGENT_REDIS_URL="redis://localhost:6379/0"
AGENT_CHECKPOINT_TTL_MINUTES=43200
AGENT_CHECKPOINT_KEY_PREFIX="ai-service:agent"
# Async batch sync of conversation transcripts to Java (MySQL) for durable storage.
# Disable to fall back to Redis-only behavior (conversations still expire per TTL).
CONVERSATION_SYNC_ENABLED=true
CONVERSATION_SYNC_INTERVAL_SECONDS=30
# Async batch sync of in-process LLM cost aggregation to Java (MySQL ai_cost_records).
COST_SYNC_ENABLED=true
COST_SYNC_INTERVAL_SECONDS=30
# History window fed to the model: at most N rounds, capped by a token budget.
AGENT_HISTORY_MAX_ROUNDS=10
AGENT_HISTORY_MAX_TOKENS=3000
MCP_SERVER_NAME="ai-service-learning-mcp"
MCP_ENABLE_LEARNING_RESOURCES=true
MCP_ENABLE_PROJECT_RESOURCES=true
# Optional. Leave blank to auto-detect the learning repository root.
# Do not point this at a directory containing secrets such as .env files.
MCP_PROJECT_RESOURCE_ROOT=""
# 产品级 MCP server（独立进程，streamable HTTP）
MCP_PRODUCT_BASE_URL="http://127.0.0.1:9100/mcp"
MCP_PRODUCT_AUTH_TOKEN=""            # 内部 Bearer token，必须设置：未设置时 product MCP server 拒绝启动（fail-fast）
MCP_PRODUCT_TIMEOUT_SECONDS=30
MCP_PRODUCT_RETRY_COUNT=2
MCP_PRODUCT_PORT=9100
# 确认凭证存储后端：memory（默认，测试用）或 redis（多进程共享确认凭证）
TOOL_CONFIRMATION_BACKEND="memory"
# 产品主链路是否经 MCP 调用工具；本地联调/生产设为 true
AGENT_MCP_TOOLS_ENABLED=false
# 多 Agent 模式开关：false=单 Agent（现有），true=监督-工作多 Agent
AGENT_MULTI_AGENT_ENABLED=false
# 监督路由模式：rule（默认，关键词）或 llm（模型路由，失败回退 rule）
SUPERVISOR_ROUTER_MODE=rule
LOG_LEVEL="INFO"
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Permit local Vite ports such as 5173, 5174, or 5175 during development.
CORS_ALLOWED_ORIGIN_REGEX="^http://(localhost|127\\.0\\.0\\.1):[0-9]+$"
OPENAI_API_KEY=""
# 可观测性：OpenTelemetry 真实接入（本机 OTLP Collector :4317）
# 留空 = 禁用 OTEL 导出（测试/无 Collector 环境）
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_SERVICE_NAME="ai-service"
# LangSmith 条件启用：需 LANGSMITH_TRACING=true 且 LANGSMITH_API_KEY 非空
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=""

# 工具动态按需注入（规则+LLM 混合感知）；false 回退全量工具
TOOL_SELECTION_ENABLED=true

# RAG 高级检索模块：routing/hybrid/rewrite 默认开启（提升检索质量）；
# multi_query / context_compression / citation_verify 默认关闭（成本/行为影响考量，可手动开启）
RAG_ENABLE_REWRITE=true
RAG_ENABLE_MULTI_QUERY=false
RAG_ENABLE_ROUTING=true
RAG_ENABLE_HYBRID=true
RAG_ENABLE_CONTEXT_COMPRESSION=false
RAG_ENABLE_CITATION_VERIFY=false
