# Java business service local environment reference.
# Spring Boot does not automatically read this file.
# Use these names in IDEA Run Configuration environment variables,
# or set them in PowerShell before running mvn spring-boot:run.
#
# Never put real secrets in .env.example.

JAVA_BUSINESS_DB_URL=jdbc:mysql://127.0.0.1:3306/ai_business?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
JAVA_BUSINESS_DB_USERNAME=root
JAVA_BUSINESS_DB_PASSWORD=root

JAVA_BUSINESS_REDIS_ENABLED=true
JAVA_BUSINESS_REDIS_HOST=192.168.88.10
JAVA_BUSINESS_REDIS_PORT=6379
JAVA_BUSINESS_REDIS_KEY_PREFIX=java-business
JAVA_BUSINESS_ORDER_CACHE_TTL_SECONDS=300
JAVA_BUSINESS_TICKET_IDEMPOTENCY_TTL_SECONDS=86400
JAVA_BUSINESS_RATE_LIMIT_ENABLED=true
JAVA_BUSINESS_RATE_LIMIT_LIMIT=60
JAVA_BUSINESS_RATE_LIMIT_WINDOW_SECONDS=60

JAVA_BUSINESS_INTERNAL_TOKEN=local-dev-internal-token
JAVA_BUSINESS_INTERNAL_ALLOWED_CALLER=ai-service
